# --- Claude (opcional: sem chave, o score usa só a heurística e a proposta usa um template) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Telegram (crie o bot com @BotFather; pegue seu chat id com @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Parâmetros comerciais (usados no score e nos rascunhos) ---
VALOR_HORA_MINIMO=60
VALOR_MINIMO_PROJETO=300
PRAZO_SEGURANCA_DIAS=2
MATCH_SCORE_MINIMO=75

# --- Agendamento ---
INTERVALO_BUSCA_MIN=30
# Pasta onde ficam agenda_freelance.md e projetos/ (pode ser seu vault do Obsidian)
AGENDA_DIR=~/freelance-hunter/agenda
DB_PATH=~/freelance-hunter/data/hunter.db
